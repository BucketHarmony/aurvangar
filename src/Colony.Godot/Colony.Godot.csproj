<Project Sdk="Godot.NET.Sdk/4.6.2">
  <!-- Godot 4.6 .NET project. View, input and UI only. Gameplay lives in Colony.Sim. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Colony.Client</RootNamespace>
    <AssemblyName>ColonyGodot</AssemblyName>
    <!-- Godot source generators are outside our control; the view is not held to warnings-as-errors. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Colony.Sim/Colony.Sim.csproj" />
    <ProjectReference Include="../Colony.ViewCore/Colony.ViewCore.csproj" />
  </ItemGroup>
</Project>
